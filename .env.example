# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WEB3FORMS_ACCESS_KEY: Optional. A free contact form submission key from web3forms.com.
# If configured, contact form submissions will be sent directly to your email in the background.
# If not configured, the contact form will fall back to opening the user's local email client.
VITE_WEB3FORMS_ACCESS_KEY=

# VITE_GOOGLE_SITE_VERIFICATION: Google Search Console HTML Meta Tag Verification Code.
VITE_GOOGLE_SITE_VERIFICATION=

# VITE_SITE_URL: Optional custom domain URL for sitemap generation (e.g. https://yourdomain.com).
VITE_SITE_URL=
